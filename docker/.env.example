# Copy to docker/.env and fill in. Keep docker/.env out of git.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# How browsers reach this server (used in OAuth callback URLs), e.g. https://superagent.example.com
SUPERAGENT_BASE_URL=
SUPERAGENT_PORT=18080
# A specific release instead of the latest, e.g. ghcr.io/oryx-labs/superagent:0.2.0
SUPERAGENT_IMAGE=ghcr.io/oryx-labs/superagent:latest
# Outbound proxy for the model APIs, if needed, e.g. http://host.docker.internal:7890
HTTPS_PROXY=
HTTP_PROXY=
