<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.3</version>
    <relativePath/>
  </parent>

  <groupId>com.superagent</groupId>
  <artifactId>superagent</artifactId>
  <version>0.1.0-RELEASE</version>
  <packaging>pom</packaging>

  <name>SuperAgent</name>
  <description>Self-hosted AI work platform for enterprises</description>

  <modules>
    <module>superagent-core</module>
    <module>superagent-api</module>
    <module>superagent-storage</module>
    <module>superagent-runtime</module>
    <module>superagent-platform</module>
    <module>superagent-skills</module>
    <module>superagent-files</module>
    <module>superagent-cost</module>
    <module>superagent-docs</module>
    <module>superagent-agent</module>
    <module>superagent-task</module>
    <module>superagent-orchestrator</module>
    <module>superagent-event</module>
    <module>superagent-web</module>
    <module>superagent-ui</module>
    <module>superagent-server</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-storage</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-platform</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-skills</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-files</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-cost</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-docs</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>software.amazon.awssdk</groupId>
        <artifactId>bom</artifactId>
        <version>2.29.6</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-task</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-orchestrator</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-ui</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-event</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.superagent</groupId>
        <artifactId>superagent-server</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
