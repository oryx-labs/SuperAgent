# Environment for bin/superagent-start.sh. Sourced as shell: KEY=value, no spaces around "=".
# Keep secrets here (not in application.properties) and restrict access: chmod 600 config/superagent.env

# JVM
# JAVA_HOME=/usr/lib/jvm/java-21
# JAVA_OPTS="-Xms512m -Xmx2g"

# HTTP port (also used by the start script's health check)
# SERVER_PORT=8080

# Initial admin. Set a strong password before the first start.
# SUPERAGENT_ADMIN_USERNAME=admin
# SUPERAGENT_ADMIN_PASSWORD=

# MySQL
# SUPERAGENT_STORAGE_MYSQL_URL=jdbc:mysql://127.0.0.1:3306/superagent
# SUPERAGENT_STORAGE_MYSQL_USERNAME=root
# SUPERAGENT_STORAGE_MYSQL_PASSWORD=

# Public address, only when browsers reach the server through a proxy or another host name: used for OAuth
# callbacks shown under System Settings. GitHub / Feishu apps themselves are set up there, not here.
# SUPERAGENT_BASE_URL=http://your-host:8080
