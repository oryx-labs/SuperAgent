<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.superagent</groupId>
    <artifactId>superagent</artifactId>
    <version>0.1.0-RELEASE</version>
  </parent>

  <artifactId>superagent-server</artifactId>
  <packaging>jar</packaging>

  <name>superagent-server</name>
  <description>Deployable server: boots the HTTP application from web module</description>

  <dependencies>
    <dependency>
      <groupId>com.superagent</groupId>
      <artifactId>superagent-web</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.superagent</groupId>
      <artifactId>superagent-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.superagent</groupId>
      <artifactId>superagent-event</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.superagent</groupId>
      <artifactId>superagent-ui</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>com.superagent</groupId>
      <artifactId>superagent-storage</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- spring-boot:run only: serve the UI straight from its source folder (jar copy as fallback), so a
               front-end edit shows on browser refresh without mvn install or a restart. The packaged jar is unaffected. -->
          <arguments>
            <argument>--spring.web.resources.static-locations=file:${project.basedir}/../superagent-ui/src/main/resources/static/,classpath:/static/</argument>
          </arguments>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Release tarball (bin/ config/ libs/ logs/ data/): mvn clean package -PreleaseTgz -->
    <profile>
      <id>releaseTgz</id>
      <build>
        <plugins>
          <plugin>
            <!-- Declared after spring-boot-maven-plugin, so it packs the already-repackaged executable jar. -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>release-tgz</id>
                <phase>package</phase>
                <goals>
                  <goal>single</goal>
                </goals>
                <configuration>
                  <descriptors>
                    <descriptor>src/assembly/release-tgz.xml</descriptor>
                  </descriptors>
                  <finalName>superagent-${project.version}</finalName>
                  <appendAssemblyId>false</appendAssemblyId>
                  <tarLongFileMode>posix</tarLongFileMode>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
